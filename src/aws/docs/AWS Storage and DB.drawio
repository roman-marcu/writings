        <mxCell id="9og8Tt8GYBWu8dkJrYvM-124" value="Amazon EFS" style="rounded=1;fillColor=#23445D;gradientColor=none;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=14" parent="1" vertex="1">
          <mxGeometry x="850" y="340" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-133" value="&lt;h1 style=&quot;margin-top: 0px; font-size: 16px; line-height: 100%;&quot;&gt;&lt;font style=&quot;font-weight: normal; font-size: 16px;&quot; face=&quot;Helvetica&quot;&gt;With EBS, you can create virtual hard drives, that we call EBS volumes, that you can attach to your EC2 instances.&lt;br&gt;&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;font-size: 16px; line-height: 100%;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot; face=&quot;Svd9QaWfxxgsUue6r5ic&quot;&gt;The data that you write to an EBS volume can persist between stops and starts of an EC2 instance.&lt;/font&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 16px; line-height: 100%;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot; face=&quot;Svd9QaWfxxgsUue6r5ic&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;font style=&quot;&quot; face=&quot;Svd9QaWfxxgsUue6r5ic&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp;EBS allows you to take incremental backups of your data called snapshots.&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="120" y="438" width="180" height="540" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-134" value="&lt;h1 style=&quot;margin-top: 0px; line-height: 100%;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;An instance store(opens in a new tab) provides temporary block-level storage for an Amazon EC2 instance. An instance store is disk storage that is physically attached to the host computer for an EC2 instance, and therefore has the same lifespan as the instanc&lt;/span&gt;&lt;br&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="355" y="438" width="180" height="540" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-135" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Service that provides object-level storage. Amazon S3 stores data as objects in buckets:&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;- The maximum object size that you can upload is 5 terabytes.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&amp;nbsp;- You can also version objects to protect them from accidental deletion.&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;-&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;You can then create permissions to limit who can see or even access objects.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Storage class:&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;- S3 Standart:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;object stored in S3 Standard has a 99.999999999 percent probability that it will remain intact after a period of 1 year.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;S3 Standard-Infrequent Access:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;It’s used for data that is accessed less frequently but requires rapid access when needed.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;S3 Glacier Flexible Retrieval: archive&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;-&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;S3 One Zone-Infrequent Access, S3 Glacier Instant Retrieval, and S3 Glacier Deep Archive&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Lifecycle policies are configuration that can move data between users automatically&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="605" y="440" width="180" height="540" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-136" value="&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Scalable file system used with AWS Cloud services and on-premises resources.&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Amazon EFS is a regional service. It stores data in and across multiple Availability Zones.&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="857" y="438" width="180" height="562" as="geometry" />
        </mxCell>
      </root>
