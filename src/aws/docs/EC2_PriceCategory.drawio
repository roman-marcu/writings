        <mxCell id="9og8Tt8GYBWu8dkJrYvM-125" value="Dedicated host" style="rounded=1;fillColor=#23445D;gradientColor=none;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontFamily=Tahoma;fontSize=14" parent="1" vertex="1">
