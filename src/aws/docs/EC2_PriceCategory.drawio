        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-126" value="" style="fillColor=#ffe6cc;strokeColor=#d79b00;opacity=30;" parent="1" vertex="1">
          <mxGeometry x="97" y="450" width="1233" height="500" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-133" value="&lt;h1 style=&quot;margin-top: 0px; font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;These instances are ideal for short-term, irregular workloads that cannot be interrupted. It is not recommended for long term usage as the other categories can give better cost options. Use it for testing, developing short living workload&lt;/font&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;fontFamily=Helvetica;fontSize=17;fontStyle=1;verticalAlign=top;spacing=1;" parent="1" vertex="1">
          <mxGeometry x="120" y="460" width="180" height="480" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-134" value="&lt;h1 style=&quot;margin-top: 0px; font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;This category is the same as on-demand but you can reserve ec2 instances for a long period like 1,2 or 3 year and get a better price. At the end of reserved period these instances will run as on-demand till you reserve it again.&amp;nbsp;&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Are 3 Types:&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;- Standard RIs&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;- Convertible RIs&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&amp;nbsp;- Scheduled RIs&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;fontFamily=Helvetica;fontSize=17;fontStyle=1;verticalAlign=top;spacing=1;" parent="1" vertex="1">
          <mxGeometry x="360" y="460" width="180" height="480" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-135" value="&lt;h1 style=&quot;margin-top: 0px; font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;This is saving plans offer by AWS, that you can make a hourly spend commitment for 1 or 3 year period term. The use above commitment is charged as on-demand.&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;As is is defined by hours of use you can change EC2 instance types over the period witch is not possible for reserved standard instances&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;br style=&quot;font-size: 17px;&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Save up to 72% compared to on-demand&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;fontFamily=Helvetica;fontSize=17;fontStyle=1;verticalAlign=top;spacing=1;" parent="1" vertex="1">
          <mxGeometry x="610" y="460" width="180" height="480" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-136" value="&lt;h1 style=&quot;margin-top: 0px; font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;These instances are flexible start and end time, also can support immediate termination or interruptions.&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Most used for background jobs, that don&#39;t affect overall system state like: some reports generation, data processing, code analysis.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;br style=&quot;font-size: 17px;&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Save up to 90% compared to on-demand&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;br style=&quot;font-size: 17px;&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;br style=&quot;font-size: 17px;&quot;&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;fontFamily=Helvetica;fontSize=17;fontStyle=1;verticalAlign=top;spacing=1;" parent="1" vertex="1">
          <mxGeometry x="860" y="458" width="180" height="480" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-138" value="&lt;h1 style=&quot;margin-top: 0px; font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;These are physical servers with EC2 instances fully dedicated to your use.&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;font-size: 17px;&quot;&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;This are the most expensive&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;fontFamily=Helvetica;fontSize=17;fontStyle=1;verticalAlign=top;spacing=1;" parent="1" vertex="1">
          <mxGeometry x="1130" y="460" width="180" height="480" as="geometry" />
        </mxCell>
      </root>
