        <mxCell id="9og8Tt8GYBWu8dkJrYvM-133" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;These instances are ideal for applications that use these resources in equal proportions, such as web servers and code repositories.&lt;/font&gt;&lt;br&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="120" y="460" width="180" height="480" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-134" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;These instances are ideal for compute intensive applications like batch processing workloads, high performance web servers, dedicated gaming servers, ad server engines because they all benefit from high performance processors&lt;/font&gt;&lt;br&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="360" y="460" width="180" height="480" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-135" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;These instances are designed&amp;nbsp;to deliver fast performance for workloads that process large data sets in memory. It can be used for&amp;nbsp;high-performance database or a workload that involves performing real-time processing of a large amount of unstructured data.&lt;/font&gt;&lt;br&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="610" y="460" width="180" height="480" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-136" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;These instances&amp;nbsp;are designed for workloads that require high, sequential read and write access to very large data sets on local storage. We can use it for&amp;nbsp;distributed file systems, data warehousing applications, and high-frequency online transaction processing (OLTP) systems.&lt;/font&gt;&lt;br&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="860" y="458" width="180" height="480" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-137" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;These instances use hardware accelerators, or coprocessors, to perform some functions more efficiently than is possible in software running on CPUs. We can use these&amp;nbsp;for workloads such as graphics applications, game streaming, and application streaming.&lt;/font&gt;&lt;br&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="1370" y="460" width="180" height="480" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-138" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;These instances&amp;nbsp;are purpose built to offer the best price performance for running HPC workloads at scale on AWS. These instances are ideal for applications that benefit from high-performance processors, such as large, complex simulations and deep learning workloads.&lt;/font&gt;&lt;br&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="1130" y="460" width="180" height="480" as="geometry" />
        </mxCell>
        <mxCell id="9og8Tt8GYBWu8dkJrYvM-144" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=1 1;glass=1;shadow=1;backgroundOutline=0;autosize=0;treeFolding=0;treeMoving=0;shadowColor=#FFFF66;sketch=1;curveFitting=1;jiggle=2;strokeWidth=3;strokeColor=#FF9999;flipH=1;flipV=1;" parent="1" vertex="1">
