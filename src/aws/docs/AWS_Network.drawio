        <mxCell id="tsMgJcmONPBiCTRYHQR3-130" value="&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Amazon Route 53&lt;/b&gt; is a DNS web service. It gives developers and businesses a reliable way to route end users to internet applications hosted in AWS.&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;perimeterSpacing=0;perimeter=centerPerimeter;align=left;spacingRight=5;spacingLeft=5;" vertex="1" parent="1">
